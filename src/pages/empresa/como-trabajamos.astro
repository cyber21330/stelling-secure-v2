---
import Layout from '../../layouts/Layout.astro';
import { CustomCursor } from '../../components/stelling/CustomCursor';
import { Navbar } from '../../components/stelling/Navbar';
import { HowWeWork } from '../../components/stelling/HowWeWork';
import { Footer } from '../../components/stelling/Footer';
---

<Layout
  title="Cómo Trabajamos | Stelling Secure"
  description="El proceso y la metodología de trabajo de Stelling Secure."
  canonicalPath="/empresa/como-trabajamos/"
>
  <CustomCursor client:load />
  <Navbar client:load />
  <main style="position:relative; z-index:1; min-height: 60vh; padding-top: 160px;">
    <section style="max-width: 1100px; margin: 0 auto; padding: 0 24px;">
      <h1 style="font-family: 'JetBrains Mono', monospace; color: #F0EEF8; font-size: 32px; letter-spacing: 0.05em;">
        Cómo Trabajamos
      </h1>
    </section>
    <section style="max-width: 1100px; margin: 0 auto; padding: 0 24px;">
      <HowWeWork client:visible />
    </section>
  </main>
  <Footer client:visible />
</Layout>
