---
import Layout from '../layouts/Layout.astro';
import { CustomCursor } from '../components/stelling/CustomCursor';
import { Navbar } from '../components/stelling/Navbar';
import { Hero } from '../components/stelling/Hero';
import { ServicesGrid } from '../components/stelling/ServicesGrid';
import { WhyUs } from '../components/stelling/WhyUs';
import { HowWeWork } from '../components/stelling/HowWeWork';
import { FAQ } from '../components/stelling/FAQ';
import { Contact } from '../components/stelling/Contact';
import { Footer } from '../components/stelling/Footer';
import { StickyCTA } from '../components/stelling/StickyCTA';
import { WhatsAppFab } from '../components/stelling/WhatsAppFab';
import { getCollection } from 'astro:content';

// Regla de build (arquitectura v4, sección 0): solo maturityLevel: 'published'
// se renderiza en producción; 'approved' se incluye solo en astro dev local
// (mismo criterio ya validado en /servicios/index.astro).
const serviceEntries = (
  await getCollection('services', ({ data }) => {
    if (import.meta.env.DEV) {
      return data.maturityLevel === 'published' || data.maturityLevel === 'approved';
    }
    return data.maturityLevel === 'published';
  })
)
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    slug: entry.data.slug,
    title: entry.data.title,
    description: entry.data.description,
    category: entry.data.category,
  }));

// Trust (WhyUs.tsx) — 4 de las 6 promesas de marca, mismo patrón que
// /empresa/nuestro-compromiso/. Filtro por id de archivo (estable,
// no depende del texto del statement) — ver análisis previo.
const TRUST_PROMISE_IDS = ['independencia', 'evidencia', 'transparencia', 'practicidad'];
const trustPromises = (
  await getCollection('promises', ({ id, data }) =>
    data.maturityLevel === 'published' && TRUST_PROMISE_IDS.includes(id)
  )
)
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ statement: entry.data.statement, order: entry.data.order }));
---

<Layout>
  <CustomCursor client:load />
  <Navbar client:load />
  <main style="position:relative; z-index:1;">
    <Hero client:load />
    <ServicesGrid services={serviceEntries} variant="home" sectionId="services" client:visible />
    <WhyUs promises={trustPromises} client:visible />
    <HowWeWork variant="home" client:visible />
    <FAQ client:visible />
    <Contact client:visible />
  </main>
  <Footer client:visible />
  <StickyCTA client:idle />
  <WhatsAppFab client:idle />
</Layout>