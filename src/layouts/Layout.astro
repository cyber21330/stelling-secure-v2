---
import '../styles/global.css';
import { Toaster } from 'sonner';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
}

const {
  title = "Stelling Secure | Ciberseguridad para PYMEs — Valencia",
  description = "Stelling Secure — Auditoría de seguridad web y evaluación de ciberseguridad para PYMES. Identificamos riesgos y priorizamos lo que protege tu negocio.",
  canonicalPath = "/",
  noindex = false
} = Astro.props;

const canonicalUrl = `https://stellingsecure.com${canonicalPath}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Alfredo Stelling Bell" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="theme-color" content="#172434" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://stellingsecure.com/og-image.jpg" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Stelling Secure" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://stellingsecure.com/og-image.jpg" />
  </head>
  <body>
    <Toaster client:load richColors position="bottom-right" />
    <slot />
  </body>
</html>
