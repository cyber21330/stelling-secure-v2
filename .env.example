# Copia este archivo como .env y rellena con tus valores reales.
# .env nunca se sube a git (ver .gitignore) — este archivo sí.

# EmailJS — servicio de envío del formulario de contacto
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# Cloudflare Turnstile — clave pública del widget anti-bots
# Consíguela en: Cloudflare Dashboard → Turnstile → tu widget → Site Key
PUBLIC_TURNSTILE_SITE_KEY=
